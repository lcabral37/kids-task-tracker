# Serves the built app over plain HTTP. HTTPS, the public host name and caching at the edge are
# the Cloudflare tunnel's job, so there are no certificates, redirects or admin API here.
#   PORT         port to listen on (default: 8080)
#   STATIC_ROOT  where the built files are (default: /srv, as in the Docker image)
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	root * {$STATIC_ROOT:/srv}

	# Vite puts a content hash in every file name under /assets/, so they never change. No index.html
	# fallback here: a tab still on an old version must get a 404 for a removed file, not HTML that
	# would then be cached for a year under the script's name.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, sw.js, the manifest, icons) must be revalidated, or installed apps
	# would keep an old service worker.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
